{
  "expo": {
    "name": "Geolarm",
    "slug": "geolarm-mobile",
    "version": "1.0.0",
    "scheme": "geolarm",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Geolarm usa tu ubicación para activar las alarmas cuando llegues a tu destino."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
